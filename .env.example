# Copy this file to .env for local execution. Never commit the real .env file.
SEC_USER_AGENT=Your Name your-email@example.com
HTTP_TIMEOUT_SECONDS=30

# Runtime mode: local, s3, or both
OUTPUT_MODE=local
RUN_ENV=local

# Optional path overrides. Docker defaults are already /app/data/...
# DATABASE_PATH=data/funding.duckdb
# CACHE_DIR=data/http_cache
# OUTPUT_DIR=data/outputs
# STAGING_DIR=data/staging
# RUN_METADATA_DIR=data/run_metadata

# Optional: use the official FRED API when populated; otherwise fredgraph.csv is used.
FRED_API_KEY=

# Required only when OUTPUT_MODE=s3 or OUTPUT_MODE=both
AWS_REGION=us-west-2
S3_BUCKET=
S3_PREFIX=
